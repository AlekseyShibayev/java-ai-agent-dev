#!/bin/sh
set -u

# Keeps the human's IDE checkout on `main`.
#
# Agents run with OPENCODE=1 and must not change the branch of the primary
# worktree: the switch is detected here and reverted. Linked worktrees created
# for agent work are not affected, the human (no OPENCODE) is not affected.
# Deliberate override: SKIP_BRANCH_GUARD=1 git switch <branch>

if [ "${SKIP_BRANCH_GUARD:-0}" = "1" ] || [ "${OPENCODE_BRANCH_GUARD:-0}" = "1" ]; then
    exit 0
fi

# Only agents, and only real branch switches (not file checkouts).
[ "${OPENCODE:-}" = "1" ] || exit 0
[ "${3:-0}" = "1" ] || exit 0

gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0
commondir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
# Linked worktree: its own HEAD, switching there is fine.
[ "$gitdir" = "$commondir" ] || exit 0

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
[ "$branch" = "main" ] && exit 0

echo >&2
echo "branch guard: the IDE checkout must stay on main." >&2
echo "agents: use a separate worktree for branch work instead of switching here." >&2
if OPENCODE_BRANCH_GUARD=1 git switch -q main 2>/dev/null; then
    echo "branch guard: restored main (override: SKIP_BRANCH_GUARD=1)." >&2
    echo >&2
    exit 0
fi

echo "branch guard: could not restore main (dirty tree?); run 'git switch main' when clean." >&2
echo >&2
exit 1
