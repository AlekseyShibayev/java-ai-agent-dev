#!/bin/sh
set -eu

# Blocks commits that contain likely secrets. Scans the staged content only.
# Bypass for a verified false positive: SKIP_SECRET_CHECK=1 git commit ...

if [ "${SKIP_SECRET_CHECK:-0}" = "1" ]; then
    echo "secret check skipped (SKIP_SECRET_CHECK=1)"
    exit 0
fi

pattern='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,}|xox[baprs]-[0-9A-Za-z-]{10,}|AIza[0-9A-Za-z_-]{35}|[0-9]{8,10}:[A-Za-z0-9_-]{35}|(password|passwd|secret|token|api[_-]?key|access[_-]?key)[[:space:]]*[:=][[:space:]]*["'\'']?[A-Za-z0-9_./+-]{8,}'

matches=$(git grep --cached -nI -E -e "$pattern" -- . 2>/dev/null || true)
matches=$(printf '%s\n' "$matches" | grep -vE '\$\{|change[_-]?me|example|placeholder|your[_-]|xxxx|<[^>]+>|\*\*\*|redacted' || true)

if [ -n "$matches" ]; then
    echo "Commit blocked: possible secrets in staged files:" >&2
    printf '%s\n' "$matches" >&2
    echo >&2
    echo "Remove the secret, or use an environment placeholder such as \${MY_SECRET}." >&2
    echo "Verified false positive: SKIP_SECRET_CHECK=1 git commit ..." >&2
    exit 1
fi

exit 0
