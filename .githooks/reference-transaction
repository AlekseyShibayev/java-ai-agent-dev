#!/bin/sh
set -u

# Blocks an agent from creating or deleting branches in the primary (IDE)
# worktree, so `git switch -c`, `git checkout -b`, `git branch -D` fail before
# HEAD moves. Likewise, agents must not create or delete refs on the host
# machine. Other refs (commits to the current branch, tags, remotes) and linked
# worktrees are not affected.
# Deliberate override: SKIP_BRANCH_GUARD=1 git <command>

[ "${1:-}" = "prepared" ] || exit 0
[ "${SKIP_BRANCH_GUARD:-0}" = "1" ] && exit 0
[ "${OPENCODE:-}" = "1" ] || exit 0

gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0
commondir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
[ "$gitdir" = "$commondir" ] || exit 0

zero=0000000000000000000000000000000000000000
while read -r old new ref; do
    case "$ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac
    if [ "$old" = "$zero" ] || [ "$new" = "$zero" ]; then
        echo "branch guard: agents must not create or delete branches in the IDE checkout ($ref)." >&2
        echo "agents: use a separate worktree for branch work (override: SKIP_BRANCH_GUARD=1)." >&2
        exit 1
    fi
done

exit 0
